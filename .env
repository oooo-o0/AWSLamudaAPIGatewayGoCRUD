# AWS関連設定
AWS_REGION=ap-northeast-1              # AWSリージョン（東京など）
AWS_PROFILE=default                    # AWS CLIのプロファイル名
LAMBDA_S3_BUCKET=your-lambda-code-bucket  # Lambda関数コードを格納するS3バケット名
LAMBDA_S3_PREFIX=kaigo-lambda          # LambdaコードS3内のパスプレフィックス

# JWT認証関連
# JWT署名鍵ファイルパス（絶対パス or 相対パスでLambda環境に配置）
JWT_PRIVATE_KEY_PATH=/var/task/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/var/task/keys/jwt_public.pem

# JWT発行者識別子（issuer）
JWT_ISSUER=kaigo-insurance-system

# JWT有効期限（秒単位、任意で使用）
JWT_EXPIRATION_SECONDS=3600


# DynamoDBテーブル名
TABLE_NAME_USER=User
TABLE_NAME_CAREPLAN=CarePlan
TABLE_NAME_CLAIM=Claim
TABLE_NAME_FACILITY=Facility
TABLE_NAME_NOTIFICATION=Notification

# Cognito (もし利用する場合)
COGNITO_USER_POOL_ID=your-user-pool-id
COGNITO_APP_CLIENT_ID=your-app-client-id

# バッチジョブの設定例（タイムアウト秒数や閾値など）
BATCH_DAILY_BILLING_TIMEOUT=300
BATCH_WEEKLY_REPORT_TIMEOUT=300
BATCH_MONTHLY_CLEANUP_TIMEOUT=300

# その他アプリケーション固有設定
APP_LOG_LEVEL=INFO                     # ログレベル DEBUG|INFO|WARN|ERROR
APP_TIMEZONE=Asia/Tokyo                # タイムゾーン設定

# メール送信などの外部サービス設定（例）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass

# フロントエンド向けAPIエンドポイント（ローカル開発用など）
API_BASE_URL=https://api.yourdomain.com

# 開発環境・本番環境を区別したい場合
ENVIRONMENT=development                # development|staging|production

